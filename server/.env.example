# Copy to server/.env for local runs, or pass these to the container.
# Only what the server needs to start lives here: regions, API keys, limits, ranking… are set live in
# the dashboard (Settings → Service) and kept in the database.

# Where GeoPol is reachable (OIDC redirect, the examples in the docs page).
PUBLIC_URL=https://geo.bayfield.dev
PORT=8840

# PostgreSQL with PostGIS (postgis/postgis:17). Docker Compose sets this for you; for local development:
#   docker run -d --name geopol-dev-db -e POSTGRES_PASSWORD=geopol -e POSTGRES_DB=geopol -p 5440:5432 postgis/postgis:17-3.5-alpine
DATABASE_URL=postgres://postgres:geopol@127.0.0.1:5440/geopol
# DATABASE_POOL_MAX=10

# --- Sign in to the dashboard with Authentik (any OIDC provider works) ---
# Authentik: Applications → Providers → OAuth2/OpenID, confidential client,
# redirect URI ${PUBLIC_URL}/api/auth/oidc/callback, scopes openid profile email.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_NAME=Authentik
# OIDC_AUTO_CREATE=true
# Comma-separated groups allowed into the dashboard (empty: anyone the provider lets through).
# OIDC_ALLOWED_GROUPS=
# Members of these groups are admins (they manage regions, API keys and settings), e.g. projects_geopol_admin.
# OIDC_ADMIN_GROUPS=

# Local development without Authentik: sign straight in as this user (created if missing, admin if first).
# Only honoured when PUBLIC_URL is http://localhost; leave unset everywhere else.
# DEV_LOGIN_USER=demo
# SESSION_IDLE_DAYS=30

# Header your reverse proxy puts the visitor IP in, used for the per-IP rate limits
# (behind a Cloudflare Tunnel: cf-connecting-ip). Leave unset if the port is reachable without the proxy.
# CLIENT_IP_HEADER=cf-connecting-ip

# --- Imports ---
# Where the Photon dumps come from (GraphHopper's mirror).
# DUMP_BASE_URL=https://download1.graphhopper.com/public
# Threads parsing a dump during an import (the slow part). Default: the cores minus one, at most 8.
# IMPORT_WORKERS=4

# Umami analytics on the dashboard pages (not the API).
# UMAMI_WEBSITE_ID=
# UMAMI_SCRIPT_URL=https://umami.example.com/script.js
# UMAMI_HOST_URL=
# UMAMI_DOMAINS=geo.bayfield.dev

# Look on GitHub for a newer release, shown in Settings → About (cached for 6 hours).
# UPDATE_CHECK=true
