{
  "name": "geopol-server",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "description": "GeoPol: geocoding API (autocomplete, search, reverse) on PostGIS, its admin dashboard and the web build",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "check": "tsc --noEmit",
    "import": "node --env-file-if-exists=.env scripts/import.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.7",
    "hono": "^4.13.18",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~7.0.2"
  }
}
